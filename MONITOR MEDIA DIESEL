
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FrotaControl - Gestão de Combustível</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    
    <!-- Configuração de Cores do Tailwind -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            900: '#312e81',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
        }

        /* Notificações (Toast) */
        .toast {
            visibility: hidden;
            min-width: 250px;
            background-color: #333;
            color: #fff;
            text-align: center;
            border-radius: 8px;
            padding: 16px;
            position: fixed;
            z-index: 50;
            left: 50%;
            bottom: 30px;
            transform: translateX(-50%);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            transition: visibility 0.5s, opacity 0.5s linear;
            opacity: 0;
            font-weight: 500;
        }
        .toast.show {
            visibility: visible;
            opacity: 1;
        }
        .toast.success { background-color: #10b981; } /* Emerald */
        .toast.error { background-color: #ef4444; } /* Red */
    </style>
</head>
<body class="text-slate-800">

    <!-- Navbar -->
    <nav class="bg-white border-b border-slate-200 shadow-sm sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center gap-3">
                    <div class="bg-brand-600 p-2 rounded-lg text-white">
                        <i class="ph-fill ph-truck text-2xl"></i>
                    </div>
                    <div>
                        <h1 class="font-bold text-xl tracking-tight text-slate-900">FrotaControl</h1>
                        <p class="text-xs text-slate-500 font-medium hidden sm:block">Gestão de Combustível Local</p>
                    </div>
                </div>
                <div class="flex items-center gap-2 px-3 py-1.5 bg-emerald-50 rounded-full border border-emerald-100">
                    <i class="ph-fill ph-check-circle text-emerald-500"></i>
                    <span class="text-xs font-semibold text-emerald-700">Sistema Ativo</span>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            
            <!-- Coluna Esquerda: Formulário -->
            <div class="lg:col-span-4 space-y-6">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
                    <h2 class="text-lg font-bold text-slate-800 mb-6 flex items-center gap-2" id="formTitle">
                        <i class="ph-bold ph-plus text-brand-600 text-xl"></i>
                        Novo Abastecimento
                    </h2>

                    <form id="fuelForm" class="space-y-4">
                        <input type="hidden" id="recordId">

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-semibold text-slate-600 mb-1">Data</label>
                                <input type="date" id="dataAbastecimento" required class="w-full rounded-xl border border-slate-300 px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500 bg-slate-50 text-slate-700">
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-slate-600 mb-1">Placa da Carreta</label>
                                <select id="placa" required class="w-full rounded-xl border border-slate-300 px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 uppercase font-medium bg-slate-50">
                                    <option value="">SELECIONE UMA PLACA...</option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-slate-600 mb-1">Local do Abastecimento</label>
                            <select id="localAbastecimento" required class="w-full rounded-xl border border-slate-300 px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500 font-medium bg-slate-50 text-slate-700">
                                <option value="Base Novo Progresso">Base Novo Progresso</option>
                                <option value="Posto Credenciado">Posto Credenciado</option>
                            </select>
                        </div>
                        
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-semibold text-slate-600 mb-1">Km Anterior</label>
                                <input type="number" id="kmAnterior" required min="0" step="1" placeholder="Ex: 50000" class="w-full rounded-xl border border-slate-300 px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500 bg-slate-50">
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-slate-600 mb-1">Km Atual</label>
                                <input type="number" id="kmAtual" required min="0" step="1" placeholder="Ex: 50800" class="w-full rounded-xl border border-slate-300 px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500 bg-slate-50">
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-semibold text-slate-600 mb-1">Litros (L)</label>
                                <input type="number" id="litros" required min="1" step="0.01" placeholder="Ex: 200" class="w-full rounded-xl border border-slate-300 px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500 bg-slate-50">
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-slate-600 mb-1">Preço (R$)</label>
                                <input type="number" id="preco" required min="0.01" step="0.01" placeholder="Ex: 5.90" class="w-full rounded-xl border border-slate-300 px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500 bg-slate-50">
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                             <div>
                                <label class="block text-sm font-semibold text-slate-600 mb-1">Tanque Cheio?</label>
                                <select id="tanqueCheio" class="w-full rounded-xl border border-slate-300 px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500 font-medium bg-slate-50 text-slate-700">
                                    <option value="SIM">SIM</option>
                                    <option value="NAO">NÃO</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-slate-600 mb-1" title="Define se esta litragem entra na conta da Média Geral">Considerar Litros?</label>
                                <select id="considerarLitragem" class="w-full rounded-xl border border-slate-300 px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500 font-medium bg-slate-50 text-slate-700">
                                    <option value="SIM">SIM (Padrão)</option>
                                    <option value="NAO">NÃO (Ignorar)</option>
                                </select>
                            </div>
                        </div>

                        <div class="pt-4 flex flex-col gap-2">
                            <button type="submit" id="btnSubmit" class="w-full px-4 py-3 bg-brand-600 text-white rounded-xl hover:bg-brand-700 font-bold shadow-sm transition-colors flex justify-center items-center gap-2">
                                <i class="ph-bold ph-floppy-disk text-lg"></i> Salvar Abastecimento
                            </button>
                            <button type="button" id="btnCancel" onclick="resetForm()" class="hidden w-full px-4 py-3 bg-white text-slate-600 border border-slate-200 rounded-xl hover:bg-slate-50 font-bold transition-colors">
                                Cancelar Edição
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Coluna Direita: Dashboard e Histórico -->
            <div class="lg:col-span-8 space-y-6">
                
                <!-- Header do Dashboard (Filtro) -->
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                    <div>
                        <h2 class="text-lg font-bold text-slate-800">Visão Gerencial</h2>
                        <p class="text-sm text-slate-500" id="filterStatusText">Analisando toda a frota</p>
                    </div>
                    <div class="flex items-center gap-2 w-full sm:w-auto">
                        <i class="ph-bold ph-funnel text-slate-400"></i>
                        <select id="filtroPlaca" onchange="applyFilter()" class="w-full sm:w-auto p-2 bg-slate-50 border border-slate-300 rounded-xl focus:ring-2 focus:ring-brand-500 font-bold text-slate-700 outline-none">
                            <option value="TODAS">Todas as Placas</option>
                        </select>
                    </div>
                </div>

                <!-- Cards de Resumo -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center gap-4" title="Calculado com base nas litragens marcadas como 'SIM'">
                        <div class="bg-blue-50 p-3 rounded-xl text-blue-600"><i class="ph-bold ph-trend-up text-2xl"></i></div>
                        <div>
                            <p class="text-sm text-slate-500 font-semibold">Média Geral</p>
                            <p class="text-2xl font-bold text-slate-800"><span id="kpiMedia">0.00</span> <span class="text-sm font-normal text-slate-500">km/L</span></p>
                        </div>
                    </div>
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center gap-4">
                        <div class="bg-emerald-50 p-3 rounded-xl text-emerald-600"><i class="ph-bold ph-truck text-2xl"></i></div>
                        <div>
                            <p class="text-sm text-slate-500 font-semibold">Total Rodado</p>
                            <p class="text-2xl font-bold text-slate-800"><span id="kpiDistancia">0</span> <span class="text-sm font-normal text-slate-500">km</span></p>
                        </div>
                    </div>
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center gap-4">
                        <div class="bg-rose-50 p-3 rounded-xl text-rose-600"><i class="ph-bold ph-gas-pump text-2xl"></i></div>
                        <div>
                            <p class="text-sm text-slate-500 font-semibold">Custo Total</p>
                            <p class="text-2xl font-bold text-slate-800" id="kpiCusto">R$ 0,00</p>
                        </div>
                    </div>
                </div>

                <!-- Lista de Registros -->
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                    <div class="p-5 border-b border-slate-200 flex justify-between items-center bg-slate-50">
                        <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                            <i class="ph-bold ph-list-dashes text-slate-500"></i> Histórico de Abastecimentos
                        </h2>
                        <span class="bg-white border border-slate-200 text-slate-600 py-1 px-3 rounded-full text-sm font-bold shadow-sm" id="recordCount">0 registros</span>
                    </div>
                    
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse min-w-[700px]">
                            <thead>
                                <tr class="bg-white text-slate-500 text-sm border-b border-slate-200">
                                    <th class="p-4 font-semibold">Data / Placa</th>
                                    <th class="p-4 font-semibold">Localização</th>
                                    <th class="p-4 font-semibold">Distância</th>
                                    <th class="p-4 font-semibold">Litros / Preço</th>
                                    <th class="p-4 font-semibold">Desempenho</th>
                                    <th class="p-4 font-semibold text-right">Ações</th>
                                </tr>
                            </thead>
                            <tbody id="recordsTableBody" class="divide-y divide-slate-100">
                                <!-- Linhas via JS -->
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <!-- Custom Modal for Delete -->
    <div id="deleteModal" class="fixed inset-0 bg-slate-900/40 z-50 hidden flex items-center justify-center backdrop-blur-sm">
        <div class="bg-white rounded-2xl p-6 max-w-sm w-full mx-4 shadow-xl">
            <div class="w-12 h-12 rounded-full bg-rose-100 flex items-center justify-center mx-auto mb-4">
                <i class="ph-bold ph-warning-circle text-rose-600 text-2xl"></i>
            </div>
            <h3 class="text-xl font-bold text-center text-slate-800 mb-2">Excluir Registro?</h3>
            <p class="text-sm text-center text-slate-500 mb-6">Esta ação não pode ser desfeita. Deseja realmente remover este abastecimento?</p>
            <div class="flex gap-3">
                <button onclick="closeDeleteModal()" class="flex-1 px-4 py-2.5 bg-slate-100 text-slate-700 rounded-xl hover:bg-slate-200 font-bold transition-colors">Cancelar</button>
                <button id="confirmDeleteBtn" class="flex-1 px-4 py-2.5 bg-rose-600 text-white rounded-xl hover:bg-rose-700 font-bold transition-colors">Sim, Excluir</button>
            </div>
        </div>
    </div>

    <!-- Toast Notification -->
    <div id="toast" class="toast">Notificação</div>

    <script>
        // 1. Lista Completa de Placas
        const PLACAS_CADASTRADAS = [
            'QCV1J51', 'QCV1J61', 'QCV1J71', 'QCV1J81', 'QCV1J91', 'QCV2A11', 'QCV2A21', 
            'QCV2A31', 'QCV2A41', 'QCW7F41', 'QCW7F91', 'QCW7G11', 'QCW7G51', 'QCW7H11', 
            'QCW7H31', 'QCW7H91', 'QCW7I51', 'QCW7J21', 'QCW7J71', 'RAN9J73', 'RAO6G83', 
            'RAO6H23', 'RAO8I73', 'RAO8J93', 'RAR5B66', 'RAS5H93', 'RAS5I23', 'RAS5I83', 
            'RAS5I93', 'RAS5J03', 'RAS9E37', 'RAT0A86', 'RAT0B36', 'RAT0B66', 'RAT0B96', 
            'RAU0G27', 'RAU2J21', 'RAU7A87', 'RAU7B07', 'RAU7B27', 'RAZ5I54', 'RAZ5J14', 
            'RAZ5J34', 'RRJ3E55', 'RRJ3F25', 'RRJ3F85', 'RRJ3G35', 'RRJ3G55', 'RRJ3G75', 
            'RRJ3H05', 'RRJ6J65', 'RRJ7A15', 'RRJ7A55', 'RRJ7A85', 'RRO5B02', 'RRO5B12', 
            'RRO5B22', 'RRO7B02', 'RRO7B22', 'RRO7B52', 'RRO7B62', 'RRP7D22', 'RRP7D52', 
            'RRS4I98', 'RRS6C71', 'RRV2J52', 'RRV2J82', 'RRV2J92', 'RRV3A32', 'RRV3A62', 
            'RRV3B06', 'RRV3B12', 'RRV3B16', 'RRV3B26', 'RRV3B32', 'RRV3B36', 'RRV3B46', 
            'RRV3B52', 'RRV3B56', 'RRV3B66', 'RRV3B72', 'RRV3B76', 'RRV3B82', 'RRV3B86', 
            'RRV3C06', 'RRV3C16', 'RRX3A91', 'RRX3B51', 'RRX3B61', 'RRX3C21', 'RRX3C41', 
            'RRX3C81', 'RRX6H07', 'RRX6H37', 'RRX6H87', 'RRX6H97', 'RRX6I17', 'RRX6I27', 
            'RRX6I37', 'RRX8A17', 'SPE2D46', 'SPE2D66', 'SPE2D76', 'SPE2D86', 'SPE2D96', 
            'SPE2E16', 'SPE2E36', 'SPE4G86', 'SPE4G96', 'SPE4H06', 'SPE4H16', 'SPE4H26', 
            'SPE5F79', 'SPE5F99', 'SPG2G39', 'SPG2G49', 'SPG2G59', 'SPG2G69', 'SPG2G79', 
            'SPG2H76', 'SPH1A89', 'SPH1A99', 'SPH1J18', 'SPH4G48'
        ];

        // 2. Estado Global
        let records = [];
        let currentFilter = 'TODAS';
        let recordToDeleteId = null;

        // Utilitários de Formatação
        const formatMoney = (value) => new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(value);
        const formatNum = (value, dec = 2) => new Intl.NumberFormat('pt-BR', { minimumFractionDigits: dec, maximumFractionDigits: dec }).format(value);

        // Conversor de data (YYYY-MM-DD para DD/MM/YYYY)
        const formatToDisplayDate = (dateStr) => {
            if (!dateStr) return '';
            if (dateStr.includes('-')) {
                const parts = dateStr.split('-');
                return `${parts[2]}/${parts[1]}/${parts[0]}`;
            }
            return dateStr;
        };

        // Conversor de data (DD/MM/YYYY para YYYY-MM-DD) para modo edição
        const formatToDateInput = (dateStr) => {
            if (!dateStr) return '';
            if (dateStr.includes('/')) {
                const parts = dateStr.split('/');
                return `${parts[2]}/${parts[1]}/${parts[0]}`;
            }
            return dateStr;
        };

        document.addEventListener('DOMContentLoaded', () => {
            const savedData = localStorage.getItem('frotaRecordsApp');
            if (savedData) records = JSON.parse(savedData);

            document.getElementById('dataAbastecimento').value = new Date().toISOString().split('T')[0];

            populateDropdowns();
            renderDashboard();
        });

        function populateDropdowns() {
            const historyPlates = records.map(r => r.placa);
            const allPlates = [...new Set([...PLACAS_CADASTRADAS, ...historyPlates])].sort();

            const formSelect = document.getElementById('placa');
            const filterSelect = document.getElementById('filtroPlaca');

            formSelect.innerHTML = '<option value="">SELECIONE UMA PLACA...</option>';
            filterSelect.innerHTML = '<option value="TODAS">Todas as Placas (Frota Inteira)</option>';

            allPlates.forEach(placa => {
                formSelect.insertAdjacentHTML('beforeend', `<option value="${placa}">${placa}</option>`);
                filterSelect.insertAdjacentHTML('beforeend', `<option value="${placa}">${placa}</option>`);
            });

            filterSelect.value = currentFilter;
        }

        function showToast(msg, type = 'success') {
            const toast = document.getElementById('toast');
            toast.textContent = msg;
            toast.className = `toast show ${type}`;
            setTimeout(() => { toast.className = toast.className.replace('show', ''); }, 3000);
        }

        document.getElementById('fuelForm').addEventListener('submit', (e) => {
            e.preventDefault();

            const id = document.getElementById('recordId').value;
            const dataInput = document.getElementById('dataAbastecimento').value;
            const placa = document.getElementById('placa').value;
            const localAbastecimento = document.getElementById('localAbastecimento').value;
            const kmAnt = parseFloat(document.getElementById('kmAnterior').value);
            const kmAtual = parseFloat(document.getElementById('kmAtual').value);
            const litros = parseFloat(document.getElementById('litros').value);
            const preco = parseFloat(document.getElementById('preco').value);
            const tanqueCheio = document.getElementById('tanqueCheio').value;
            const considerarLitragem = document.getElementById('considerarLitragem').value; // Novo Campo

            if (kmAtual <= kmAnt) {
                showToast('Hodômetro Atual deve ser MAIOR que o Anterior!', 'error');
                return;
            }

            const distancia = kmAtual - kmAnt;
            // Média do registro individual (para display apenas)
            const media = distancia / litros;
            const custoTotal = litros * preco;
            const custoKm = custoTotal / distancia;

            const recordTimestamp = new Date(dataInput + 'T12:00:00').getTime();

            const newRecord = {
                id: id ? id : Date.now().toString(),
                data: dataInput,
                timestamp: recordTimestamp,
                placa, 
                localAbastecimento, // Novo Campo
                kmAnterior: kmAnt, 
                hodometroAtual: kmAtual,
                litros, 
                precoLitro: preco, 
                tanqueCheio,
                considerarLitragem, // Novo Campo
                distancia, media, custoTotal, custoKm
            };

            if (id) {
                const index = records.findIndex(r => r.id === id);
                records[index] = newRecord;
                showToast('Registro editado com sucesso!');
            } else {
                records.push(newRecord);
                showToast('Abastecimento salvo com sucesso!');
            }

            localStorage.setItem('frotaRecordsApp', JSON.stringify(records));
            
            resetForm();
            populateDropdowns(); 
            renderDashboard();
        });

        function editRecord(id) {
            const r = records.find(x => x.id === id);
            if(!r) return;

            document.getElementById('recordId').value = r.id;
            document.getElementById('dataAbastecimento').value = formatToDateInput(r.data);
            document.getElementById('placa').value = r.placa;
            document.getElementById('localAbastecimento').value = r.localAbastecimento || 'Base Novo Progresso';
            document.getElementById('kmAnterior').value = r.kmAnterior;
            document.getElementById('kmAtual').value = r.hodometroAtual;
            document.getElementById('litros').value = r.litros;
            document.getElementById('preco').value = r.precoLitro;
            document.getElementById('tanqueCheio').value = r.tanqueCheio || 'SIM';
            document.getElementById('considerarLitragem').value = r.considerarLitragem || 'SIM';

            document.getElementById('formTitle').innerHTML = '<i class="ph-bold ph-pencil-simple text-amber-500 text-xl"></i> Editando Registro';
            document.getElementById('btnSubmit').innerHTML = '<i class="ph-bold ph-check text-lg"></i> Atualizar Dados';
            document.getElementById('btnSubmit').className = "w-full px-4 py-3 bg-amber-500 text-white rounded-xl hover:bg-amber-600 font-bold shadow-sm transition-colors flex justify-center items-center gap-2";
            document.getElementById('btnCancel').classList.remove('hidden');

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function resetForm() {
            document.getElementById('fuelForm').reset();
            document.getElementById('recordId').value = '';
            document.getElementById('dataAbastecimento').value = new Date().toISOString().split('T')[0];
            document.getElementById('localAbastecimento').value = 'Base Novo Progresso';
            document.getElementById('tanqueCheio').value = 'SIM';
            document.getElementById('considerarLitragem').value = 'SIM';
            
            document.getElementById('formTitle').innerHTML = '<i class="ph-bold ph-plus text-brand-600 text-xl"></i> Novo Abastecimento';
            document.getElementById('btnSubmit').innerHTML = '<i class="ph-bold ph-floppy-disk text-lg"></i> Salvar Abastecimento';
            document.getElementById('btnSubmit').className = "w-full px-4 py-3 bg-brand-600 text-white rounded-xl hover:bg-brand-700 font-bold shadow-sm transition-colors flex justify-center items-center gap-2";
            document.getElementById('btnCancel').classList.add('hidden');
        }

        function openDeleteModal(id) {
            recordToDeleteId = id;
            document.getElementById('deleteModal').classList.remove('hidden');
        }

        function closeDeleteModal() {
            recordToDeleteId = null;
            document.getElementById('deleteModal').classList.add('hidden');
        }

        document.getElementById('confirmDeleteBtn').addEventListener('click', () => {
            if (recordToDeleteId) {
                records = records.filter(r => r.id !== recordToDeleteId);
                localStorage.setItem('frotaRecordsApp', JSON.stringify(records));
                renderDashboard();
                showToast('Registro apagado com sucesso!');
                closeDeleteModal();
                populateDropdowns();
            }
        });

        function applyFilter() {
            currentFilter = document.getElementById('filtroPlaca').value;
            const statusText = document.getElementById('filterStatusText');
            
            if(currentFilter === 'TODAS') {
                statusText.textContent = 'Analisando toda a frota';
            } else {
                statusText.textContent = `Analisando a carreta ${currentFilter}`;
            }
            renderDashboard();
        }

        function renderDashboard() {
            let filteredRecords = records;
            if (currentFilter !== 'TODAS') {
                filteredRecords = records.filter(r => r.placa === currentFilter);
            }

            // ============================================================
            // NOVA LÓGICA DE CÁLCULO (Baseada na Escolha do Usuário)
            // ============================================================
            let tDist = 0, tLitrosParaMedia = 0, tCusto = 0;

            filteredRecords.forEach(r => {
                tDist += r.distancia;
                tCusto += r.custoTotal;
                
                // Só adiciona os litros na conta da Média Geral se a opção for 'SIM' ou não existir (retrocompatibilidade)
                if (r.considerarLitragem === 'SIM' || !r.considerarLitragem) {
                    tLitrosParaMedia += parseFloat(r.litros);
                }
            });

            const mediaGeral = tLitrosParaMedia > 0 ? (tDist / tLitrosParaMedia) : 0;

            document.getElementById('kpiDistancia').textContent = formatNum(tDist, 0);
            document.getElementById('kpiMedia').textContent = formatNum(mediaGeral);
            document.getElementById('kpiCusto').textContent = formatMoney(tCusto);
            document.getElementById('recordCount').textContent = `${filteredRecords.length} registros`;

            // ============================================================
            // RENDERIZAÇÃO DA TABELA
            // ============================================================
            const tbody = document.getElementById('recordsTableBody');
            tbody.innerHTML = '';

            if (filteredRecords.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" class="p-12 text-center text-slate-500">
                            <i class="ph-fill ph-gas-pump text-5xl text-slate-200 mb-3 block"></i>
                            <p class="text-lg font-semibold">Nenhum abastecimento encontrado.</p>
                            <p class="text-sm">Os registros aparecerão aqui.</p>
                        </td>
                    </tr>
                `;
                return;
            }

            // Ordenar por data mais recente
            filteredRecords.sort((a, b) => b.timestamp - a.timestamp);

            filteredRecords.forEach(record => {
                
                // Tags Visuais
                const localStr = record.localAbastecimento || 'Não Informado';
                const iconLocal = localStr === 'Base Novo Progresso' ? 'ph-warehouse' : 'ph-gas-pump';
                const displayDate = formatToDisplayDate(record.data);
                
                const tanqueTag = record.tanqueCheio === 'NAO' 
                    ? `<span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-700 border border-amber-200">Incompleto</span>`
                    : `<span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-700 border border-emerald-200">Tanque Cheio</span>`;
                
                const ignoradoTag = record.considerarLitragem === 'NAO'
                    ? `<span class="inline-block mt-1 px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-500 border border-slate-200" title="Não soma na Média Geral">Litragem Ignorada</span>`
                    : '';

                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50 transition-colors";
                tr.innerHTML = `
                    <td class="p-4">
                        <div class="font-bold text-slate-800 text-base">${record.placa}</div>
                        <div class="text-xs text-slate-500 flex items-center gap-1 mt-0.5"><i class="ph ph-calendar-blank"></i> ${displayDate}</div>
                    </td>
                    <td class="p-4">
                        <div class="flex items-center gap-1.5 text-sm font-medium text-slate-700">
                            <i class="ph ${iconLocal} text-slate-400 text-lg"></i>
                            ${localStr}
                        </div>
                    </td>
                    <td class="p-4">
                        <div class="font-semibold text-slate-700">${formatNum(record.distancia, 0)} km</div>
                        <div class="text-xs text-slate-400 mt-0.5">${formatNum(record.kmAnterior, 0)} → ${formatNum(record.hodometroAtual, 0)}</div>
                    </td>
                    <td class="p-4">
                        <div class="font-semibold text-slate-700">${formatNum(record.litros)} L</div>
                        <div class="text-xs text-slate-400 mt-0.5 mb-1">R$ ${formatNum(record.precoLitro)} /L</div>
                        <div class="flex flex-col items-start gap-1">
                            ${tanqueTag}
                            ${ignoradoTag}
                        </div>
                    </td>
                    <td class="p-4">
                        <div class="inline-block px-2 py-1 bg-brand-50 text-brand-700 border border-brand-200 rounded text-sm font-bold">
                            ${formatNum(record.media)} km/L
                        </div>
                        <div class="text-xs text-slate-500 mt-1 ml-1">R$ ${formatNum(record.custoKm)} /km</div>
                    </td>
                    <td class="p-4 text-right">
                        <div class="flex items-center justify-end gap-1">
                            <button onclick="editRecord('${record.id}')" class="p-2 text-slate-400 hover:text-amber-500 hover:bg-amber-50 rounded-lg transition-colors" title="Editar">
                                <i class="ph-bold ph-pencil-simple text-lg"></i>
                            </button>
                            <button onclick="openDeleteModal('${record.id}')" class="p-2 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors" title="Excluir">
                                <i class="ph-bold ph-trash text-lg"></i>
                            </button>
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }
    </script>
</body>
</html>
